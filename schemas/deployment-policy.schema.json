{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "deployment"],
  "properties": {
    "version": { "const": 1 },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "approval_provider", "workflow", "environments"],
      "properties": {
        "adapter": { "const": "filesystem-reference-v1" },
        "approval_provider": { "const": "github-environment-protection" },
        "workflow": { "type": "string", "minLength": 1 },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "approval_required", "concurrency_group", "health", "migration", "github_token_permissions", "external_secrets"],
            "properties": {
              "enabled": { "type": "boolean" },
              "approval_required": { "const": true },
              "concurrency_group": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "health": {
                "type": "object",
                "additionalProperties": false,
                "required": ["required_assets", "verify_artifact_digest", "verify_sbom_digest", "verify_certificate_binding"],
                "properties": {
                  "required_assets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
                  "verify_artifact_digest": { "const": true },
                  "verify_sbom_digest": { "const": true },
                  "verify_certificate_binding": { "const": true }
                }
              },
              "migration": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allowed_strategies"],
                "properties": { "allowed_strategies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["none"] } } }
              },
              "github_token_permissions": {
                "type": "object",
                "additionalProperties": false,
                "required": ["contents", "actions", "deployments"],
                "properties": { "contents": { "const": "read" }, "actions": { "const": "read" }, "deployments": { "const": "write" } }
              },
              "external_secrets": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    }
  }
}
