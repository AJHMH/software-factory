{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "environment", "gate", "gateSource", "workflow", "runId", "actor", "trustedRevision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "environment": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "gate": { "enum": ["approved", "pending", "rejected"] },
    "gateSource": { "const": "github-environment-protection" },
    "workflow": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "actor": { "type": "string", "minLength": 1 },
    "trustedRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
