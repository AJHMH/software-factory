{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object", "additionalProperties":false,
  "required":["version","repository","pull_request","revision","base_revision","author","reviews"],
  "properties":{
    "version":{"const":"1.0"},
    "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pull_request":{"type":"integer","minimum":1},
    "revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "base_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "author":{"type":"string","minLength":1,"maxLength":100},
    "reviews":{"type":"array","maxItems":10000,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","login","type","state","commit_id","submitted_at","permission"],
      "properties":{
        "id":{"type":"integer","minimum":1},"login":{"type":"string","minLength":1,"maxLength":100},
        "type":{"enum":["User","Bot"]},"state":{"enum":["APPROVED","CHANGES_REQUESTED","COMMENTED","DISMISSED"]},
        "commit_id":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "submitted_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
        "permission":{"enum":["none","read","triage","write","maintain","admin"]}
      }
    }}
  }
}
