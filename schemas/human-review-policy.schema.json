{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["version", "human_review"],
  "properties": {
    "version": {"enum": [1, "1.0"]},
    "human_review": {
      "type": "object", "additionalProperties": false,
      "required": ["mandatory_paths", "conditional_triggers", "approvals_required"],
      "properties": {
        "mandatory_paths": {"type":"array", "minItems":1, "uniqueItems":true, "items":{"type":"string", "pattern":"^[A-Za-z0-9_.*/-]+$", "maxLength":256}},
        "agent_accounts": {"type":"array", "uniqueItems":true, "items":{"type":"string", "pattern":"^[A-Za-z0-9_-]+(?:\\[bot\\])?$"}},
        "conditional_triggers": {
          "type":"object", "additionalProperties":false, "required":["lines_changed_threshold","decrease_in_test_coverage","modifies_database_schema"],
          "properties":{"lines_changed_threshold":{"type":"integer","minimum":1},"decrease_in_test_coverage":{"type":"boolean"},"modifies_database_schema":{"type":"boolean"}}
        },
        "approvals_required": {
          "type":"object", "additionalProperties":false, "required":["default","critical_paths"],
          "properties":{"default":{"type":"integer","minimum":1,"maximum":10},"critical_paths":{"type":"integer","minimum":2,"maximum":10}}
        }
      }
    }
  }
}
