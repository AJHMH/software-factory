{
  "$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,
  "required":["version","revision","tree_digest","contract_digest","workload_id","profile","analyses"],
  "properties":{
    "version":{"const":"1.0"},"revision":{"$ref":"#/definitions/sha"},"tree_digest":{"$ref":"#/definitions/sha"},"contract_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "workload_id":{"type":"string","minLength":1},"profile":{"const":"node-24"},
    "analyses":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["id","revision","ref","language","build_mode","tool_version","rules_count","status","findings"],
      "properties":{
        "id":{"type":"integer","minimum":1},"revision":{"$ref":"#/definitions/sha"},"ref":{"type":"string","pattern":"^refs/(pull/[0-9]+/head|heads/[A-Za-z0-9._/-]+)$"},
        "language":{"const":"javascript-typescript"},"build_mode":{"const":"none"},"tool_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "rules_count":{"type":"integer","minimum":1},"status":{"enum":["success","error","unsupported"]},
        "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["rule","severity","path","line","help_url"],"properties":{
          "rule":{"type":"string","minLength":1,"maxLength":200},"severity":{"enum":["critical","high","medium","low","none"]},
          "path":{"type":"string","minLength":1,"maxLength":1000},"line":{"type":"integer","minimum":1},"help_url":{"type":"string","pattern":"^https://(codeql\\.github\\.com/|github\\.com/github/codeql/)"}
        }}}
      }
    }}
  },"definitions":{"sha":{"type":"string","pattern":"^[a-f0-9]{40}$"}}
}
