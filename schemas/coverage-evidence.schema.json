{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "base_revision",
    "workload_id",
    "profile",
    "contract_digest",
    "files",
    "baseline",
    "tests"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "profile": {
      "const": "node-24"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_digest",
          "lines",
          "branches"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^\\\\\\r\\n]+\\.mjs$"
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lines": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[1-9][0-9]*$": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "line",
                "hits",
                "end_line"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "hits": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "files"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "source_digest",
              "lines",
              "branches"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[^\\\\\\r\\n]+\\.mjs$"
              },
              "source_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "lines": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[1-9][0-9]*$": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "line",
                    "hits",
                    "end_line"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "\\S"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "hits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "integration"
      ],
      "properties": {
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "status",
            "exit_code"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "status",
            "exit_code"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-run"
              ]
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
