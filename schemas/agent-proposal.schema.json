{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "adapter", "actions"],
  "properties": {
    "version": {"const": "1.0"}, "adapter": {"type": "string", "maxLength": 64},
    "actions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["tool", "path", "content"],
      "properties": {"tool": {"type": "string", "maxLength": 64}, "path": {"type": "string", "maxLength": 240}, "content": {"type": "string", "maxLength": 65536}}
    }},
    "context": {"type": "object", "additionalProperties": false, "properties": {
      "repository": {"type": "string", "maxLength": 65536}, "issue": {"type": "string", "maxLength": 65536}, "logs": {"type": "string", "maxLength": 65536}
    }},
    "fixture": {"type": "object", "additionalProperties": false, "properties": {
      "failures_before_success": {"type": "integer", "minimum": 0, "maximum": 100}, "delay_ms": {"type": "integer", "minimum": 0, "maximum": 2000}
    }}
  }
}
